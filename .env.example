# Copy to .env for local development. Never commit .env.
# In staging/production, provide these variables through your secret manager /
# orchestrator. Values here are local-development placeholders only.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Local Postgres used by docker-compose.yml. The password here is not a secret
# and must be changed for anything shared beyond your workstation.
POSTGRES_USER=marketscope
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=marketscope
# Created automatically by docker/postgres/init on a fresh Postgres volume.
POSTGRES_TEST_DB=marketscope_test

# Host-run application/tests. The API container overrides this with the
# `postgres` service hostname. If the password contains URL-reserved characters,
# URL-encode them or choose a password without reserved characters for local dev.
DATABASE_URL=postgresql+asyncpg://marketscope:local-dev-only-change-me@127.0.0.1:5432/marketscope

# Integration tests run only when this is set. The database name MUST contain
# "test"; the test suite refuses to run destructive setup otherwise.
TEST_DATABASE_URL=postgresql+asyncpg://marketscope:local-dev-only-change-me@127.0.0.1:5432/marketscope_test

# Optional vector store. When set, it participates in readiness checks.
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=3

# Operator-controlled HTTP boundary.
# Production must set this explicitly (wildcards are rejected).
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=
# DOCS_ENABLED=false  # default: enabled outside production, disabled in production

# OIDC resource server. The backend verifies bearer JWTs; it does not run a
# browser login flow and never trusts role/permission claims. Production requires
# OIDC_ENABLED=true and https issuer/JWKS URIs. Without OIDC the /api/v1 routes
# fail closed with 401 (health probes remain available).
OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com
# OIDC_AUDIENCE=marketscope-api
# OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
OIDC_ALGORITHMS=RS256
# Custom signed claim containing the tenant UUID used as a lookup key only.
OIDC_TENANT_CLAIM=tenant_id
OIDC_LEEWAY_SECONDS=60
OIDC_JWKS_CACHE_SECONDS=300
OIDC_HTTP_TIMEOUT_SECONDS=10
CORS_ALLOW_CREDENTIALS=false
MAX_REQUEST_BODY_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=60
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Database pool / timeouts.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=marketscope-backend
DB_ECHO=false

# Local S3-compatible object storage (MinIO service in docker-compose.yml).
# Production must use a real bucket with TLS, bucket-level encryption and
# lifecycle policies; do not use these local root credentials there.
MINIO_ROOT_USER=marketscope_minio
MINIO_ROOT_PASSWORD=local-dev-minio-only-change-me
S3_BUCKET=marketscope-documents

# Document ingestion / RAG. RAG_ENABLED=true exposes document and search routes.
# Production validation rejects local Qdrant mode, local object storage and the
# hash embedding provider.
RAG_ENABLED=true
OBJECT_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=marketscope_minio
S3_SECRET_KEY=local-dev-minio-only-change-me
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path
S3_AUTO_CREATE_BUCKET=true
S3_TIMEOUT_SECONDS=10

DOCUMENT_MAX_BYTES=8388608
DOCUMENT_MAX_PARSED_CHARS=2000000
DOCUMENT_MAX_PAGES=500
DOCUMENT_MAX_CHUNKS=5000
# A stale processing/deleting state older than this lease can be retried.
DOCUMENT_STATE_LEASE_SECONDS=600
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=100

# Development-only deterministic embedding. Production requires an HTTP
# embedding endpoint and a dimension matching the Qdrant collection.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-v1
EMBEDDING_VERSION=1
EMBEDDING_DIMENSION=256
# EMBEDDING_API_URL=https://embeddings.example.com/v1/embeddings
# EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2

QDRANT_COLLECTION=document_chunks
QDRANT_LOCAL_MODE=false
SEARCH_CANDIDATE_LIMIT=50
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50

# External search / isolated collection. The worker runs as a separate process
# (`python -m app.collector.worker`) and uses the same object storage for raw
# snapshots. Production must use a non-superuser DB role and TLS.
COLLECTOR_ENABLED=true
COLLECTOR_USER_AGENT=MarketScopeCollector/0.1 (+https://example.invalid/collector)
COLLECTOR_ALLOWED_DOMAINS=
COLLECTOR_BLOCKED_DOMAINS=
# Only allowed in development/test; production rejects true.
COLLECTOR_ALLOW_PRIVATE_NETWORKS=false
COLLECTOR_ALLOWED_PORTS=80,443
COLLECTOR_ALLOWED_CONTENT_TYPES=text/html,text/plain,application/xhtml+xml
COLLECTOR_REQUEST_TIMEOUT_SECONDS=10
COLLECTOR_MAX_RESPONSE_BYTES=2000000
COLLECTOR_MAX_EXTRACTED_CHARS=200000
COLLECTOR_MAX_REDIRECTS=3
COLLECTOR_RESPECT_ROBOTS=true
COLLECTOR_ROBOTS_CACHE_SECONDS=3600
COLLECTOR_ROBOTS_MAX_BYTES=512000
COLLECTOR_MAX_CONCURRENT_TASKS=4
COLLECTOR_POLL_INTERVAL_SECONDS=2
COLLECTOR_TASK_LEASE_SECONDS=120
COLLECTOR_MAX_ATTEMPTS=3
COLLECTOR_RETRY_BASE_SECONDS=5
COLLECTOR_RETRY_MAX_SECONDS=300
COLLECTOR_DOMAIN_MIN_INTERVAL_SECONDS=1
COLLECTOR_MAX_TASKS_PER_REQUEST=20

# Generic HTTP search provider; results remain untrusted until collected.
WEB_SEARCH_PROVIDER=none
# WEB_SEARCH_API_URL=https://search.example.com/query
# WEB_SEARCH_API_KEY=
WEB_SEARCH_API_KEY_HEADER=X-API-Key
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=10

# OpenTelemetry (disabled by default). Endpoints must be operator-controlled.
OTEL_ENABLED=false
# OTLP/HTTP trace endpoint. The application derives the /v1/metrics endpoint for
# its optional OpenTelemetry metrics export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SERVICE_NAME=marketscope-backend
OTEL_TRACES_SAMPLER_RATIO=1.0

# LangGraph multi-agent research. The worker runs separately
# (`python -m app.agent.worker`) and writes durable checkpoints to PostgreSQL.
# AGENT_PROVIDER=deterministic is a local contract-test stub, not a real LLM;
# production requires AGENT_PROVIDER=http with an https, operator-controlled
# model gateway. External source and document content is sent to that gateway as
# untrusted data. Model credentials are read from the environment/secret manager.
AGENT_ENABLED=true
AGENT_PROVIDER=deterministic
AGENT_MODEL=deterministic-v1
# AGENT_API_URL=https://models.example.com/v1/research
# AGENT_API_KEY=
AGENT_API_KEY_HEADER=Authorization
AGENT_PROVIDER_TIMEOUT_SECONDS=30
AGENT_PROVIDER_MAX_RETRIES=2
AGENT_PROVIDER_RETRY_BASE_SECONDS=0.5
AGENT_MAX_RESPONSE_BYTES=1000000
AGENT_MAX_OBJECTIVE_CHARS=2000
AGENT_MAX_ROUNDS=3
AGENT_MAX_PARALLEL_TASKS=6
AGENT_MAX_TASK_ATTEMPTS=2
AGENT_MAX_FINDINGS_PER_TASK=5
AGENT_MAX_FINDINGS=50
AGENT_MAX_EVIDENCE_ITEMS=5
AGENT_MAX_EVIDENCE_CHARS=4000
AGENT_MAX_LEADS=10
AGENT_MAX_INPUT_TOKENS=120000
AGENT_MAX_OUTPUT_TOKENS=30000
AGENT_MAX_OUTPUT_TOKENS_PER_CALL=4000
AGENT_MAX_COST_MICROS=2000000
# Set per-1K-token gateway prices to enforce the cost budget; 0 disables the
# corresponding cost accounting/limit.
AGENT_INPUT_COST_MICROS_PER_1K=0
AGENT_OUTPUT_COST_MICROS_PER_1K=0
AGENT_MAX_TOOL_CALLS=48
AGENT_MAX_TOOL_CALLS_PER_TASK=4
AGENT_MAX_SECONDS=600
AGENT_TASK_TIMEOUT_SECONDS=120
AGENT_MIN_FINDINGS_FOR_FOLLOWUP=2
AGENT_MAX_CHECKPOINT_BYTES=1000000
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_POLL_INTERVAL_SECONDS=2
AGENT_RUN_LEASE_SECONDS=300
AGENT_MAX_RUN_ATTEMPTS=3

# Evidence review and report delivery (stage 6). The same agent worker runs
# review and export jobs after research runs. Review rules are deterministic;
# report exports use the same object storage as RAG/collection.
REPORT_ENABLED=true
REPORT_AUTO_REVIEW=true
REPORT_MAX_FOLLOWUP_ROUNDS=1
REPORT_MAX_FOLLOWUP_QUESTIONS=3
REPORT_MAX_CLAIMS=100
REPORT_MAX_EVIDENCE_PER_CLAIM=10
REPORT_MAX_LINEAGE_FINDINGS=500
REPORT_MAX_EVIDENCE_AGE_DAYS=730
REPORT_MIN_INDEPENDENT_SOURCES=1
REPORT_MIN_SUPPORT_SCORE=0.1
REPORT_CONFLICT_MIN_SHARED_TOKENS=3
REPORT_MAX_CONTENT_CHARS=1000000
REPORT_REVIEW_LEASE_SECONDS=300
REPORT_REVIEW_MAX_ATTEMPTS=3
REPORT_REVIEW_POLL_INTERVAL_SECONDS=5
REPORT_MAX_CONCURRENT_REVIEWS=2
REPORT_EXPORT_LEASE_SECONDS=120
REPORT_EXPORT_MAX_ATTEMPTS=3
REPORT_EXPORT_POLL_INTERVAL_SECONDS=2
REPORT_MAX_CONCURRENT_EXPORTS=2
REPORT_MAX_EXPORT_BYTES=20000000

# Transactional outbox / Kafka event bus. Development defaults to a logging
# publisher; production validation requires Kafka with TLS and consumer enabled.
EVENTS_OUTBOX_ENABLED=true
EVENT_PUBLISHER=log
EVENT_TOPIC=marketscope.domain-events
EVENT_DEAD_LETTER_TOPIC=marketscope.domain-events.dead-letter
EVENT_CONSUMER_ENABLED=false
EVENT_CONSUMER_GROUP=marketscope-backend
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CLIENT_ID=marketscope-events
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CAFILE=/etc/ssl/certs/kafka-ca.pem
EVENT_OUTBOX_POLL_INTERVAL_SECONDS=2
EVENT_OUTBOX_BATCH_SIZE=100
EVENT_OUTBOX_MAX_ATTEMPTS=8
EVENT_OUTBOX_RETRY_BASE_SECONDS=1
EVENT_OUTBOX_RETRY_MAX_SECONDS=300
EVENT_OUTBOX_LEASE_SECONDS=60
EVENT_CONSUMER_MAX_ATTEMPTS=3
EVENT_CONSUMER_POLL_TIMEOUT_MS=1000

# Temporal durable research lifecycle orchestration. Development defaults to the
# PostgreSQL queue worker; production validation requires Temporal with TLS.
TEMPORAL_ENABLED=false
# TEMPORAL_HOST=127.0.0.1:7233
TEMPORAL_TLS=false
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=marketscope-research
TEMPORAL_POLL_INTERVAL_SECONDS=5
TEMPORAL_WORKFLOW_MAX_SECONDS=86400
TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=300

# Monitoring subscriptions, change detection, and notification delivery
# (stage 8). The monitoring worker schedules collector tasks, compares source
# snapshots, and delivers notifications through encrypted channel configs.
MONITORING_ENABLED=false
MONITORING_POLL_INTERVAL_SECONDS=5
MONITORING_RUN_LEASE_SECONDS=300
MONITORING_RUN_MAX_ATTEMPTS=3
MONITORING_MAX_CONCURRENT_RUNS=2
MONITORING_MAX_SOURCES_PER_RUN=20
MONITORING_MIN_CADENCE_MINUTES=5
MONITORING_MAX_CADENCE_MINUTES=10080
MONITORING_DEFAULT_CADENCE_MINUTES=60
MONITORING_NEW_SOURCE_SEVERITY=medium
MONITORING_CHANGE_SEVERITY=high

# Fernet key used to encrypt notification channel URLs and signing secrets at
# rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production refuses to start with monitoring enabled when this is unset.
# NOTIFICATION_ENCRYPTION_KEY=
# Set only during rotation; decrypt-only fallback for old ciphertext.
# NOTIFICATION_PREVIOUS_ENCRYPTION_KEY=
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_RESPONSE_BYTES=65536
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=5
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_POLL_INTERVAL_SECONDS=5
NOTIFICATION_MAX_CONCURRENT_DELIVERIES=4
# Comma-separated host suffixes allowed as webhook destinations. Empty means
# any public HTTPS host that passes SSRF/DNS validation.
NOTIFICATION_ALLOWED_DOMAINS=
# Development only. Production rejects true.
NOTIFICATION_ALLOW_HTTP=false
NOTIFICATION_SIGNING_HEADER=X-MarketScope-Signature
NOTIFICATION_MAX_PAYLOAD_BYTES=65536

# Per-tenant quotas. Limits are stored in tenant_quotas and can be tightened
# at runtime by a tenant admin through GET/PATCH /api/v1/quotas.
QUOTA_DEFAULT_MAX_ACTIVE_RESEARCH_RUNS=10
QUOTA_DEFAULT_MAX_PENDING_COLLECTION_TASKS=100
QUOTA_DEFAULT_MAX_MONITOR_SUBSCRIPTIONS=20
QUOTA_DEFAULT_MAX_CONCURRENT_MONITOR_RUNS=2
QUOTA_DEFAULT_MAX_NOTIFICATION_DELIVERIES_PER_DAY=1000

# Production observability. The metrics endpoint is outside the OIDC API prefix;
# when enabled in production a bearer token of at least 24 characters is
# mandatory. Keep the endpoint cluster-internal or behind an authenticated proxy.
METRICS_ENABLED=false
METRICS_PATH=/metrics
# METRICS_BEARER_TOKEN=

# Operational retention. The job only touches processed events, resolved
# consumer failures, and published outbox rows. Business records require a
# separate tenant data-lifecycle decision. Destructive mode is opt-in.
RETENTION_OPERATIONAL_DAYS=180
RETENTION_EVENT_DAYS=30
RETENTION_BATCH_SIZE=1000
RETENTION_DESTRUCTIVE_ENABLED=false
# Export structured logs through OTLP/HTTP as well as stdout. Context fields are
# redacted before export; exception text may still require provider-side scrubbing.
OTEL_LOGS_ENABLED=false

# Aggregate queue-depth exporter (separate process, no tenant labels).
OPS_METRICS_PORT=9101
OPS_METRICS_INTERVAL_SECONDS=30

# Optional email notification adapter. Recipients are stored encrypted on the
# notification channel; SMTP credentials come from environment/secret manager.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=marketscope@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RECIPIENTS=20
